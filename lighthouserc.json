{
    "ci": {
        "collect": {
            "startServerCommand": "npm run dev",
            "startServerReadyPattern": "Ready in",
            "url": [
                "http://127.0.0.1:3000/",
                "http://127.0.0.1:3000/blog/welcome-to-my-blog"
            ],
            "numberOfRuns": 1,
            "settings": {
                "preset": "desktop"
            }
        },
        "assert": {
            "assertions": {
                "categories:performance": [
                    "warn",
                    {
                        "minScore": 0.7
                    }
                ],
                "categories:accessibility": [
                    "warn",
                    {
                        "minScore": 0.9
                    }
                ],
                "categories:seo": [
                    "warn",
                    {
                        "minScore": 0.9
                    }
                ],
                "largest-contentful-paint": [
                    "warn",
                    {
                        "maxNumericValue": 3000
                    }
                ],
                "cumulative-layout-shift": [
                    "warn",
                    {
                        "maxNumericValue": 0.1
                    }
                ]
            }
        },
        "upload": {
            "target": "temporary-public-storage"
        }
    }
}